# LiveKit self-hosted (ADR-012) — local dev credentials only. NOT LiveKit Cloud.

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_HTTP_URL=http://127.0.0.1:7880

# SIP synthetic gate — local trunk number (no real PSTN)
LIVEKIT_SIP_INBOUND_NUMBER=+15550001000

# IMVERA runtime participant identity prefix (webhooks ignore these)
IMVERA_LIVEKIT_IDENTITY_PREFIX=imvera-runtime

# Webhook target (host-visible from LiveKit container)
IMVERA_LIVEKIT_WEBHOOK_URL=http://127.0.0.1:9200/livekit/webhook

# Room prefix for per-call dispatch (dispatchRuleIndividual)
LIVEKIT_ROOM_PREFIX=imvera-call-
