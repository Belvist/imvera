<profile name="internal">
  <!-- Reference overlay for P0-A Docker; image build patches vanilla internal.xml instead. -->
  <domains>
    <domain name="all" alias="true" parse="false"/>
  </domains>
  <settings>
    <param name="context" value="public"/>
    <param name="auth-calls" value="false"/>
    <param name="auth-all-packets" value="false"/>
    <param name="rtp-ip" value="auto"/>
    <param name="sip-ip" value="auto"/>
    <param name="ext-rtp-ip" value="auto"/>
    <param name="ext-sip-ip" value="auto"/>
    <!-- Zoiper lab: G722 wideband first (HD), G711 fallback for PSTN-like legs. -->
    <param name="inbound-codec-prefs" value="G722,PCMU,PCMA"/>
    <param name="outbound-codec-prefs" value="G722,PCMU,PCMA"/>
  </settings>
</profile>
