<?xml version="1.0" encoding="utf-8"?>
<!-- P0-A: community mod_audio_stream uplink only; 880 Hz downlink = FS tone_stream -->
<include>
  <context name="public">
    <extension name="imvera_inbound">
      <condition field="destination_number" expression="^\+?15550001000$">
        <action application="answer"/>
        <action application="log" data="INFO IMVERA P0-A answered ${uuid}"/>
        <action application="set" data="imvera_ws_url=$${imvera_media_bridge_ws}/${uuid}"/>
        <action application="eval" data="${uuid_audio_stream(${uuid} start ${imvera_ws_url} mono 16k)}"/>
        <action application="playback" data="tone_stream://%(25000,0,880);loops=-1"/>
        <action application="sleep" data="25000"/>
        <action application="hangup"/>
      </condition>
    </extension>
    <!-- Zoiper human lab: CallActor via mod_audio_stream duplex (STREAM_PLAYBACK JSON) -->
    <extension name="imvera_zoiper_lab">
      <condition field="destination_number" expression="^7000$">
        <action application="answer"/>
        <action application="set" data="rtp_auto_adjust=true"/>
        <action application="set" data="sip_nat_detected=false"/>
        <action application="log" data="INFO IMVERA Zoiper CallActor ${uuid}"/>
        <action application="set" data="STREAM_PLAYBACK=1"/>
        <action application="set" data="imvera_ws_url=$${imvera_media_bridge_ws}/${uuid}"/>
        <action application="eval" data="${uuid_audio_stream(${uuid} start ${imvera_ws_url} mono 16k)}"/>
        <action application="set" data="RECORD_READ_ONLY=true"/>
        <action application="record_session" data="/var/imvera/forensic/${uuid}_read.wav"/>
        <action application="sleep" data="3600000"/>
        <action application="hangup"/>
      </condition>
    </extension>
    <extension name="unmatched">
      <condition>
        <action application="playback" data="tone_stream://%(2000,0,480);loops=1"/>
        <action application="hangup" data="SERVICE_UNAVAILABLE"/>
      </condition>
    </extension>
  </context>
</include>
