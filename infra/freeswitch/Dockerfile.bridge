FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY packages ./packages
COPY services/imvera_media_bridge ./services/imvera_media_bridge
COPY tools ./tools

RUN pip install --no-cache-dir -e '.[api]'

ENV IMVERA_MEDIA_BRIDGE_PORT=9210
EXPOSE 9210

CMD ["python", "services/imvera_media_bridge/main.py"]
