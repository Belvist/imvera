# Edge TLS for Product API (ROADMAP E9)
# Replace api.imvera.ru with real DNS + email for ACME.
# Upstream is the compose service name: loopback is Caddy's own container.

api.imvera.ru {
        reverse_proxy product:9480
        encode gzip
        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains"
                X-Content-Type-Options nosniff
                X-Frame-Options DENY
                Referrer-Policy no-referrer
        }
}
